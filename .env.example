# 企业微信 Bot 配置
WECOM_BOT_ID=your_bot_id_here
WECOM_BOT_SECRET=your_bot_secret_here

# Grok CLI 配置
GROK_BIN=/root/.local/bin/grok
GROK_MODEL=longcat
LONGCAT_API_KEY=your_api_key_here

# ── 可选调优参数（不填则使用默认值）──
# 保活心跳间隔(ms)：长任务期间每隔多久发一条"处理中"续命流式通道。默认 25000
KEEPALIVE_MS=25000
# grok 进程防卡死超时(ms)：超过则杀进程并提示。默认 1800000 (30 分钟)
GROK_TIMEOUT_MS=1800000
# 多轮上下文：注入最近多少条历史消息。默认 10
CTX_TURNS=10
# 多轮上下文：每条历史消息截断到的字符数。默认 500
CTX_PER_MSG=500

NODE_ENV=production
