# 企业微信 Bot 配置
WECOM_BOT_ID=your_bot_id_here
WECOM_BOT_SECRET=your_bot_secret_here

# Grok CLI 配置
GROK_BIN=/root/.local/bin/grok
GROK_MODEL=grok
LONGCAT_API_KEY=your_api_key_here

# 超时与保活参数
KEEPALIVE_MS=25000
GROK_TIMEOUT_MS=1800000
SEND_TIMEOUT_MS=8000

# 多轮上下文
CTX_TURNS=10
CTX_PER_MSG=500

# 进程池大小
POOL_SIZE=3

# 指标服务端口
METRICS_PORT=9090

# SQLite 数据库路径（可选）
# CONVERSATION_DB=/root/grok-wecom-bot/data/conversations.db

# Redis 缓存 URL（可选）
# REDIS_URL=redis://localhost:6379

# 共享 Agent 目录
SHARED_AGENT_DIR=/root/.qwenpaw/workspaces/default/memory/shared

NODE_ENV=production
